/// Host-facing capability interfaces — implemented by the host, imported
/// by the particle runtime. Versioned together so capability bumps stay
/// coherent.
///
/// Spec: docs/initial-design.md §2.
package particle:host@0.1.0;

interface credentials {
  variant credential-error {
    not-configured,
    storage-error(string),
    type-mismatch(string),       // wrong API for credential type
  }

  enum apply-kind {
    basic,                       // -> Authorization: Basic <placeholder>
    bearer,                      // -> Authorization: Bearer <placeholder>
    header,                      // -> <name>: <placeholder>
    auth-scheme,                 // -> Authorization: <scheme> <placeholder>
    query-param,                 // -> ?<name>=<placeholder>
  }

  record apply-spec {
    kind: apply-kind,
    name: option<string>,
    scheme: option<string>,
  }

  record placeholder-info {
    placeholder: string,
    apply: apply-spec,
  }

  /// For basic, oauth2, apikey (substitution-based types).
  get-placeholder: func(name: string) -> result<placeholder-info, credential-error>;

  /// Only for type: "raw" credentials. Returns the actual stored value.
  get-raw: func(name: string) -> result<string, credential-error>;

  /// Returns the method name the user configured for the named
  /// credential at setup, or `none` when no method is set. Particles
  /// that declare multiple alternative methods (e.g. `oauth2` +
  /// `apikey` for the same provider) call this to find out which
  /// method backs the named credential.
  get-configured-method: func(name: string) -> result<option<string>, credential-error>;
}

interface oauth {
  variant oauth-error {
    not-configured,
    not-oauth,
    refresh-failed(string),
  }

  /// Force a refresh regardless of cached expiry. Used when upstream
  /// returns 401/403 on a token we thought was still valid.
  refresh: func(name: string) -> result<_, oauth-error>;
}

interface signing {
  variant signing-error {
    not-configured,
    not-signing-key,
    invalid-input(string),
  }

  sign: func(name: string, data: list<u8>) -> result<list<u8>, signing-error>;
  verify: func(name: string, data: list<u8>, signature: list<u8>)
    -> result<bool, signing-error>;
}

interface kv {
  variant kv-error {
    storage-error(string),
    quota-exceeded,
  }

  get: func(key: string) -> result<option<string>, kv-error>;
  set: func(key: string, value: string) -> result<_, kv-error>;
  delete: func(key: string) -> result<_, kv-error>;
  // `list` is a WIT reserved keyword; escape with `%` (still callable as
  // `list` from JS — the camelCase mapping strips the prefix).
  %list: func(prefix: string) -> result<list<string>, kv-error>;
}

// Dynamic loader interface. The host implements `dyld` by reading
// .so files from a host-provided fs.FS, allocating memory in the
// caller's heap, growing the caller's __indirect_function_table,
// building an env shim module, and instantiating the .so via
// wazero's ImportResolver. See `internal/runtime/dyld` for the Go
// implementation.
//
// Two layers of users:
//   - User Python (or whatever guest) calls `load` + `library.symbol`
//     to dlopen-style load extension .so's at runtime.
//   - The runtime's main.wasm calls `set-libraries` and `initialize`
//     once at component instantiation to hand the loader the
//     toolchain-composed LIBRARIES table and to give the host a
//     stable handle to the inject-capture-injected core module.
//     These two are plumbing for the wasm-tools component-link
//     build pipeline; user code doesn't touch them.
interface dyld {
  // Opaque handle to a loaded dynamic library. Dropping it tears
  // down the .so's instance + frees its heap-allocated memory
  // region in the caller's linear memory.
  resource library {
    // Look up a function symbol by name. Returns the function's
    // table index in the caller's __indirect_function_table. Index
    // is stable for the lifetime of the library handle (loaded at
    // dyld.load time from the .so's elem section).
    symbol: func(name: string) -> result<u32, string>;
  }

  variant dyld-error {
    not-configured,
    load-failed(string),
  }

  // One symbol exported by a pre-loaded library — see
  // `preloaded-library` and `set-libraries`.
  //
  // `address` is the kind-agnostic value matching wasm-tools' libdl
  // convention (wit-component/src/linking.rs:91-110): for function
  // symbols it's the absolute index in main's
  // __indirect_function_table; for data symbols it's the absolute
  // memory address. The kind is never recorded on the symbol —
  // it's inferred by the lookup context (env.GOT.func.X reads it
  // as a table index; env.GOT.mem.X reads it as a memory address).
  // The layout matches wasm-tools' Symbol struct exactly, so the
  // Rust shim can deserialize the in-memory LIBRARIES table via
  // straight reads before marshalling into canon-ABI records.
  record preloaded-symbol {
    name: string,
    address: u32,
  }

  // One pre-loaded library — a side module already composed into
  // the component at build time (e.g., via `wasm-tools component
  // link`), whose function references are already placed in main's
  // table and whose data lives at known addresses inside main's
  // memory. `set-libraries` hands these to the loader so the env
  // shim built for runtime-loaded .so files can resolve their
  // GOT.func.X / GOT.mem.X / NEEDED entries against pre-loaded
  // libraries' contributions, not just main's own exports.
  record preloaded-library {
    name: string,
    symbols: list<preloaded-symbol>,
  }

  // Hand the loader the full set of libraries already composed
  // into the component at build time. Toolchain-generated init
  // modules drive this indirectly: wasm-tools' Linker::encode
  // emits an init module whose start function calls
  // `__wasm_set_libraries(ptr)`. Main's Rust shim provides
  // `__wasm_set_libraries`; it reads the LIBRARIES struct from its
  // own linear memory and calls into this WIT method with
  // canon-ABI-marshalled records.
  //
  // "Set" rather than "register": this replaces any prior
  // registration, matching the C-level
  // `__wasm_set_libraries(ptr)` semantics. Called once during
  // component instantiation, before any runtime dyld.load fires.
  set-libraries: func(libraries: list<preloaded-library>) -> result<_, string>;

  // Load a .so by name. Name resolution is host-specific (current
  // implementation: lookup in the fs.FS handed to the dyld adapter
  // at construction).
  load: func(name: string) -> result<library, dyld-error>;

  // One-time component-init hook. A post-link injected core module
  // (see tools/inject-capture) imports the union of every composed
  // library's exports, re-exports them, imports this WIT function,
  // and calls it from its start function. When the handler runs,
  // `host.CallerCoreModule(ctx)` returns the injected module — a
  // single Module that exports every symbol the env shim needs
  // (memory, __indirect_function_table, __stack_pointer, every
  // libc/libpython/etc. function + main-side stubs). The host
  // stashes that reference; subsequent .so loads route env-shim
  // imports against it without probing wazero's namespace.
  initialize: func();
}
// Trampoline-generation interface for cffi/libffi-style FFI dispatch.
// The libffi shell that emits the `__wasi_libffi_*` C-level externs
// lives in the particle wheels repo
// (https://github.com/partite-ai/particle-python-wheels) as part of
// the cffi wheel build; the Rust side of python-runtime lowers them
// into this WIT, and internal/runtime/libffi/ holds the Go-side
// wasm-encoder implementation.
//
// The libffi shell (in cffi-built .so's) calls ffi_call(cif, fn,
// rvalue, avalue). Implementing that requires marshaling avalue[]
// into wasm-stack values and doing call_indirect with the target's
// type. On wasi we can't construct wasm functions at runtime from
// Rust — but we can ask the host to do it for us. This interface
// is the channel: the host emits a tiny wasm module per unique
// target signature, places its "trampoline" function into main's
// __indirect_function_table, returns the slot index, and main.wasm
// uses a fixed-signature call_indirect at that slot.
//
// Signatures are encoded as a packed byte sequence:
//   byte 0:        num-results (0 or 1; libffi targets at most one)
//   byte 1:        num-params (0..=64 supported)
//   bytes 2..:     result type, then param types, one byte each
//
// Type bytes (matching wasm valtype encoding, low-byte only):
//   0x7f = i32, 0x7e = i64, 0x7d = f32, 0x7c = f64
//
// The same sig descriptor maps to one cached trampoline; repeat
// calls with the same sig return the same table index.
interface libffi {
  variant libffi-error {
    unsupported-signature(string),
    table-full,
  }

  // Return an indirect-function-table slot whose trampoline calls
  // a function with the given signature. The trampoline's own
  // signature is fixed `(fn_idx: u32, rvalue: u32, avalue: u32)
  // -> ()` — main.wasm's `__wasi_libffi_dispatch` wasm-asm helper
  // does call_indirect via this slot, the trampoline reads
  // avalue[i] from memory, type-promotes per the encoded signature,
  // performs the actual call_indirect at the target, and stores
  // the result at *rvalue.
  prep-trampoline: func(sig: list<u8>) -> result<u32, libffi-error>;

  // Build a closure trampoline at a pre-allocated table slot.
  // closure-ptr layout (libffi convention): u32@0 ftramp (slot),
  // u32@4 cif, u32@8 fun (table idx), u32@12 user_data.
  prep-closure: func(closure-ptr: u32, slot: u32, sig: list<u8>) -> result<_, libffi-error>;
}
