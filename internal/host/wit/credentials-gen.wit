package particle:host@0.1.0;

/// `credentials-gen` is the synthetic world wacogo-witgen generates
/// the credentials capability bindings from. It imports just the
/// credentials interface so the produced binding tree is scoped to
/// credentials and doesn't drag in oauth/signing/kv types.
///
/// Each host capability gets its own gen-world file in this same
/// `particle:host` package — siblings will land here for oauth,
/// signing, and kv when those bindings come online.
world credentials-gen {
  import credentials;
}
